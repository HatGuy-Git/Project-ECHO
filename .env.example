# ONLY local credentials — same pattern as Continuum.
# Copy to .env (gitignored). Do not put ElevenLabs, AssemblyAI, or other app keys here.
#
# All other secrets come from AWS Secrets Manager at startup:
#   Secret name: ace-mode/config
#   JSON: ELEVENLABS_API_KEY, ASSEMBLYAI_API_KEY,
#         ELEVENLABS_TUTOR_VOICE_ID, ELEVENLABS_MAINFRAME_VOICE_ID,
#         ELEVENLABS_GLITCH_VOICE_ID, BEDROCK_MODEL_ID

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SECRET_NAME=ace-mode/config
