# Project ECHO Environment Variables 
# Copy this file to .env and fill in your API keys 
 
# ElevenLabs API key for text-to-speech 
# Get yours at: https://elevenlabs.io/ 
VITE_ELEVENLABS_API_KEY= 
 
# AssemblyAI API key for speech-to-text 
# Get yours at: https://www.assemblyai.com/ 
VITE_ASSEMBLYAI_API_KEY= 
 
# Optional: Custom voice IDs for characters 
VITE_MAINFRAME_VOICE_ID= 
VITE_DR_GLITCH_VOICE_ID=
