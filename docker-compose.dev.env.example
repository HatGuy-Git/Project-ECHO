# Copy to docker-compose.dev.env (gitignored) or .env
# These are the ONLY credentials stored locally — same as Continuum.
#
#   docker compose --env-file docker-compose.dev.env up --build
#
# Use an IAM user that can:
#   secretsmanager:GetSecretValue on ace-mode/config
#   textract:DetectDocumentText
#   bedrock:InvokeModel / bedrock:InvokeModelWithResponseStream
#
# All other keys (ElevenLabs, AssemblyAI, voice IDs) live in AWS Secrets Manager:
#   Secret name: ace-mode/config
#   JSON keys: ELEVENLABS_API_KEY, ASSEMBLYAI_API_KEY,
#              ELEVENLABS_TUTOR_VOICE_ID, ELEVENLABS_MAINFRAME_VOICE_ID,
#              ELEVENLABS_GLITCH_VOICE_ID, BEDROCK_MODEL_ID

AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_SECRET_NAME=ace-mode/config
